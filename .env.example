# =============================================================
# Flawless Hermes Agentic OS — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.
# =============================================================

# --- Anthropic / Claude Code ---
# Required. Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Obsidian ---
# Required. Absolute path to your local Obsidian vault.
# macOS example:    /Users/yourname/Documents/Obsidian Vault
# Linux example:    /home/yourname/ObsidianVault
# WSL2 example:     /mnt/c/Users/yourname/Documents/ObsidianVault
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# --- OpenClaw Gateway ---
# Optional. Port where OpenClaw gateway listens.
OPENCLAW_GATEWAY_PORT=4242

# --- Hermes Agent ---
# Optional. Port where Hermes Agent API listens.
HERMES_PORT=7777

# --- Dashboard ---
# Optional. Port for the Next.js dashboard.
NEXT_PUBLIC_DASHBOARD_PORT=3000
