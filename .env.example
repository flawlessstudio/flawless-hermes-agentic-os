# ── Hermes Agent OS — Environment Variables ──────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ── API / Backend ─────────────────────────────────────────────────────

# Base directory for all persistent data (SQLite, ChromaDB, locks)
HERMES_DATA_DIR=./data

# Allowed CORS origins for the FastAPI backend (comma-separated)
HERMES_CORS_ORIGINS=http://localhost:3000

# Log level: DEBUG | INFO | WARNING | ERROR
HERMES_LOG_LEVEL=INFO

# Emit structured JSON logs (set to 1 in production)
HERMES_JSON_LOGS=0

# ── Frontend ──────────────────────────────────────────────────────────

# Backend API base URL (consumed by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Claude API (PAUSA HUMANA — never commit) ──────────────────────────
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=<PAUSA_HUMANA>

# Claude model to use for agent reasoning
HERMES_CLAUDE_MODEL=claude-sonnet-4-6

# ── MCP Connectors (PAUSA HUMANA — never commit) ─────────────────────

# GitHub personal access token (for GitHub MCP connector)
GITHUB_PERSONAL_ACCESS_TOKEN=<PAUSA_HUMANA>

# Exa API key (for web search)
EXA_API_KEY=<PAUSA_HUMANA>

# Supabase (optional — cloud DB connector)
SUPABASE_URL=<PAUSA_HUMANA>
SUPABASE_SERVICE_ROLE_KEY=<PAUSA_HUMANA>

# Sentry DSN (for error observability)
SENTRY_DSN=<PAUSA_HUMANA>

# Slack (for Slack MCP connector)
SLACK_BOT_TOKEN=<PAUSA_HUMANA>
SLACK_TEAM_ID=<PAUSA_HUMANA>

# Linear (for PM connector)
LINEAR_API_KEY=<PAUSA_HUMANA>

# Cloudflare (for edge deployment)
CLOUDFLARE_API_TOKEN=<PAUSA_HUMANA>
CLOUDFLARE_ACCOUNT_ID=<PAUSA_HUMANA>

# Stripe (PAUSA HUMANA — payment operations require explicit human confirmation)
STRIPE_SECRET_KEY=<PAUSA_HUMANA>

# E2B sandbox
E2B_API_KEY=<PAUSA_HUMANA>

# ElevenLabs (voice/audio)
ELEVENLABS_API_KEY=<PAUSA_HUMANA>
