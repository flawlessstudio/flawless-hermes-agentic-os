# Flawless Hermes Agentic OS — optional local adapter configuration
# The validated scaffold runs without credentials or local agent access.
# Copy to .env.local only when implementing a reviewed adapter.
# Never commit real values.

# Optional future Claude adapter. Disabled in the scaffold.
ANTHROPIC_API_KEY=

# Optional future local vault adapter. No vault content is read by the scaffold.
OBSIDIAN_VAULT_PATH=

# Optional future local gateway endpoints. No network probes are made by the scaffold.
OPENCLAW_GATEWAY_PORT=4242
HERMES_PORT=7777

# Dashboard
NEXT_PUBLIC_DASHBOARD_PORT=3000
